+def _hook_module_forward_marlin_safe(module, on_forward_end, get_parameter_and_buffer_dicts):
+    """Marlin-safe forward hook: swaps param.data in-place instead of using
+    functional_call(). functional_call() breaks Marlin CUDA kernels because it
+    creates a shadow module with different data_ptr() addresses, while Marlin
+    accesses weights via raw CUDA pointers resolved during kernel launch."""
+    original_forward = module.forward
+
+    def forward(*args, **kwargs):
+        device_dicts = get_parameter_and_buffer_dicts()
+        saved_data = {}
+
+        for name, gpu_tensor in device_dicts.items():
+            parts = name.split(".")
+            obj = module
+            for part in parts[:-1]:
+                obj = getattr(obj, part)
+            param = getattr(obj, parts[-1])
+            saved_data[name] = (obj, parts[-1], param.data)
+            param.data = gpu_tensor
+
+        module.forward = original_forward
+        output = module(*args, **kwargs)
+
+        for name, (parent, attr_name, orig_data) in saved_data.items():
+            getattr(parent, attr_name).data = orig_data
+
+        on_forward_end()
+        module.forward = forward
+        return output
+
+    module.forward = forward
+
