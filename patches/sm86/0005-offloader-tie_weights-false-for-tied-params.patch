From 93cb3bf6598d66e28c19456485a236aee24f5b2c Mon Sep 17 00:00:00 2001
From: root <root@owui-llama-n8n.cioinside.com>
Date: Mon, 27 Jul 2026 11:24:15 +0000
Subject: [PATCH] fix: pass tie_weights=False to functional_call in offloader

Qwen3.5 Mamba layers have tied parameters (linear_attn.attn.dt_bias
/ linear_attn.dt_bias). When functional_call tries to reparametrize
these, it raises ValueError for duplicate keys. Pass tie_weights=False
to both V1 (cpu_offload_gb) and V2 (offloader_kwargs) paths so tied
parameters are handled correctly.

Tested on 2x RTX 3060 12GB (SM86): CPU offload no longer crashes
on tied params during inference.
---
 python/sglang/srt/utils/offloader.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/python/sglang/srt/utils/offloader.py b/python/sglang/srt/utils/offloader.py
index 2e72b3c061..8a58623522 100644
--- a/python/sglang/srt/utils/offloader.py
+++ b/python/sglang/srt/utils/offloader.py
@@ -142,7 +142,7 @@ class OffloaderV1(BaseOffloader):
                     k: v.to(device, non_blocking=True)
                     for k, v in module.state_dict().items()
                 }
-                output = functional_call(module, device_state, args=args, kwargs=kwargs)
+                output = functional_call(module, device_state, args=args, kwargs=kwargs, tie_weights=False)
                 module.forward = forward
                 return output
 
@@ -263,7 +263,7 @@ def _hook_module_forward_raw(module, on_forward_end, get_parameter_and_buffer_di
     def forward(*args, **kwargs):
         module.forward = original_forward
         output = functional_call(
-            module, get_parameter_and_buffer_dicts(), args=args, kwargs=kwargs
+            module, get_parameter_and_buffer_dicts(), args=args, kwargs=kwargs, tie_weights=False
         )
         on_forward_end()
         module.forward = forward
-- 
2.51.0

